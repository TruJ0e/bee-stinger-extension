# Bee developer token (Developer Mode must be enabled in the Bee app).
# Never commit a real token.
BEE_TOKEN=

# Concept extraction — any OpenAI-compatible chat endpoint.
# If LLM_API_KEY is empty, the deterministic offline extractor is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# TruCalenZer outside route (contract: see docs/ARCHITECTURE.md).
# Adapters are dry-run unless the CLI is run with --live.
TRUCALENZER_ROUTE_URL=
TRUCALENZER_ROUTE_TOKEN=
