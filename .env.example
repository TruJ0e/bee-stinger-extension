# Bee developer token (Developer Mode must be enabled in the Bee app).
# Never commit a real token.
BEE_TOKEN=

# Concept extraction — any OpenAI-compatible chat endpoint.
# If LLM_API_KEY is empty, the deterministic offline extractor is used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# TruCalenZer has no inbound network listener; see docs/ARCHITECTURE.md.
# Route A (always, local): output/trucalenzer-import.json — import it in
# TruCalenZer. Optional: the student's display name in TruCalenZer, used
# when a coordinator install manages several students.
TRUCALENZER_STUDENT_NAME=
# Route B (--live only): a Microsoft Graph access token (Calendars.ReadWrite)
# for the same Microsoft account TruCalenZer's Outlook sync is connected to.
# Creates "Torgy"-category events that TruCalenZer imports on its next sync.
TRUCALENZER_GRAPH_TOKEN=
